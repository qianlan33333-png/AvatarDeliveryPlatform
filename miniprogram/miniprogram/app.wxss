page {
  min-height: 100%;
  background: #fdf8e7;
  color: #2d2d2d;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

view,
text,
button,
input,
textarea,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
}

button::after {
  border: 0;
}

.screen {
  min-height: 100vh;
  padding: 32rpx 28rpx;
}

.surface-card {
  background: #ffffff;
  border: 2rpx solid rgba(224, 169, 60, 0.2);
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(67, 52, 22, 0.07);
}

.eyebrow {
  color: #9a7200;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.section-title {
  display: block;
  margin-top: 14rpx;
  color: #2d2d2d;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.35;
}

.section-copy {
  display: block;
  margin-top: 16rpx;
  color: #746f65;
  font-size: 28rpx;
  line-height: 1.7;
}

.primary-button {
  min-height: 88rpx;
  padding: 0 34rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 44rpx;
  background: #f5d060;
  color: #2d2d2d;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1;
}

.primary-button[disabled] {
  background: #ede9df;
  color: #a39d91;
}

.safe-area-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}
