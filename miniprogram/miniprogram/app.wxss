page { min-height: 100%; background: #faf9f5; color: #1f1e1d; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
view, text, button, input, textarea, scroll-view { box-sizing: border-box; }
button { margin: 0; }
button::after { border: 0; }
.screen { min-height: 100vh; padding: 32rpx 28rpx calc(132rpx + env(safe-area-inset-bottom)); }
.surface-card { border: 2rpx solid #e5e2da; border-radius: 24rpx; background: #fff; box-shadow: 0 2rpx 4rpx rgba(60,50,40,.04); }
.eyebrow { color: #a24a2c; font-size: 22rpx; font-weight: 600; letter-spacing: 2rpx; }
.section-title { display: block; margin-top: 14rpx; color: #1f1e1d; font-family: "Songti SC", serif; font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.section-copy { display: block; margin-top: 16rpx; color: #6b6862; font-size: 28rpx; line-height: 1.7; }
.primary-button { min-height: 84rpx; padding: 0 32rpx; display: flex; align-items: center; justify-content: center; border-radius: 16rpx; background: #d97757; color: #fff; font-size: 28rpx; font-weight: 650; line-height: 1; }
.primary-button[disabled] { background: #efede6; color: #a5a099; }
.safe-area-bottom { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.empty-symbol { width: 104rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; background: #f0eee6; color: #8f8b83; font-family: "Songti SC", serif; font-size: 38rpx; font-weight: 700; }
.empty-title { margin-top: 26rpx; color: #1f1e1d; font-family: "Songti SC", serif; font-size: 30rpx; font-weight: 700; }
.empty-copy { max-width: 560rpx; margin-top: 14rpx; color: #8f8b83; font-size: 24rpx; line-height: 1.7; }
