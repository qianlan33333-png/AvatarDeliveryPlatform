.courses-page { padding: 24rpx 28rpx calc(136rpx + env(safe-area-inset-bottom)); background: #faf9f5; }
.state-card, .empty-card { min-height: 420rpx; padding: 56rpx 40rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; }
.loading-dot { width: 34rpx; height: 34rpx; border: 5rpx solid #f0eee6; border-top-color: #d97757; border-radius: 50%; animation: spin .8s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.error-symbol { border-radius: 50%; background: #f8e9e4; color: #bc4c2e; }
.retry-button { min-width: 220rpx; margin-top: 28rpx; }
.course-list { display: flex; flex-direction: column; gap: 20rpx; }
.course-card { position: relative; min-height: 232rpx; padding: 20rpx; display: flex; overflow: hidden; border: 2rpx solid #e5e2da; border-radius: 24rpx; background: #fff; box-shadow: 0 2rpx 4rpx rgba(60,50,40,.04); }
.course-card-active { background: #fdf9f7; }
.course-cover, .course-cover-image { width: 144rpx; height: 192rpx; flex-shrink: 0; overflow: hidden; border-radius: 16rpx; background: #f0eee6; }
.course-body { min-width: 0; min-height: 192rpx; flex: 1; margin-left: 24rpx; display: flex; flex-direction: column; }
.course-title, .course-learning { display: -webkit-box; overflow: hidden; -webkit-box-orient: vertical; }
.course-title { padding-right: 104rpx; color: #1f1e1d; font-family: "Songti SC", serif; font-size: 32rpx; font-weight: 700; line-height: 1.4; -webkit-line-clamp: 2; }
.enrollment-badge { position: absolute; z-index: 1; top: 20rpx; right: 20rpx; padding: 6rpx 13rpx; border-radius: 12rpx; font-size: 20rpx; font-weight: 700; line-height: 1.2; }
.enrollment-badge.enrolled { background: #e9efe8; color: #4a6b52; }
.enrollment-badge.not-enrolled { background: #efede6; color: #6b6862; }
.course-learning { margin-top: 12rpx; color: #6b6862; font-size: 25rpx; line-height: 1.45; -webkit-line-clamp: 1; }
.course-footer { margin-top: auto; display: flex; align-items: center; color: #8f8b83; font-size: 24rpx; line-height: 1.3; }
.meta-divider { margin: 0 10rpx; color: #a5a099; }
.course-progress-text { color: #c15f3c; font-weight: 700; }
.preview-pill { margin-left: auto; padding: 5rpx 11rpx; border-radius: 10rpx; background: #f7ede8; color: #a24a2c; font-size: 20rpx; font-weight: 650; }
