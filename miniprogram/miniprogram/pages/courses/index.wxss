.courses-page {
  padding-bottom: calc(44rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(44rpx + env(safe-area-inset-bottom));
}

.intro-card {
  padding: 38rpx 34rpx;
  background: linear-gradient(145deg, #fffdf7 0%, #ffffff 70%);
}

.list-heading {
  margin: 42rpx 8rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.list-title {
  color: #36332e;
  font-size: 30rpx;
  font-weight: 700;
}

.list-meta {
  color: #999286;
  font-size: 24rpx;
}

.empty-card {
  min-height: 500rpx;
  padding: 70rpx 44rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.empty-symbol {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  background: #f5d060;
  color: #2d2d2d;
  font-size: 42rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 32rpx;
  color: #36332e;
  font-size: 32rpx;
  font-weight: 700;
}

.empty-copy {
  max-width: 560rpx;
  margin-top: 18rpx;
  color: #817a6e;
  font-size: 26rpx;
  line-height: 1.7;
}

.state-row {
  margin-top: 30rpx;
  display: flex;
  align-items: center;
}

.state-tag {
  color: #9a7200;
  font-size: 24rpx;
}

.state-separator {
  margin: 0 14rpx;
  color: #d3c7ac;
  font-size: 24rpx;
}
