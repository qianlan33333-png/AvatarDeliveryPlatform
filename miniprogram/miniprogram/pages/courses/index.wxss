.courses-page {
  padding: 22rpx 28rpx calc(44rpx + constant(safe-area-inset-bottom));
  padding: 22rpx 28rpx calc(44rpx + env(safe-area-inset-bottom));
  background: #fbf7ec;
}

.state-card,
.empty-card {
  min-height: 430rpx;
  padding: 58rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.loading-dot {
  width: 34rpx;
  height: 34rpx;
  border: 5rpx solid #efe6cd;
  border-top-color: #d9a900;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.error-symbol {
  background: #fff0ef;
  color: #b42318;
}

.retry-button {
  min-width: 220rpx;
  margin-top: 28rpx;
}

.course-list {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.course-card {
  min-height: 232rpx;
  padding: 20rpx;
  display: flex;
  overflow: hidden;
  border: 2rpx solid #f0e9d9;
  border-radius: 24rpx;
  background: #ffffff;
  box-shadow: 0 8rpx 22rpx rgba(73, 61, 35, 0.04);
}

.course-card-active {
  background: #fffcf4;
}

.course-cover,
.course-cover-image {
  width: 144rpx;
  height: 192rpx;
  flex-shrink: 0;
  overflow: hidden;
  border-radius: 16rpx;
  background: #f3ead8;
}

.course-body {
  min-width: 0;
  min-height: 192rpx;
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.course-title,
.course-learning {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
}

.course-title {
  color: #282725;
  font-size: 32rpx;
  font-weight: 750;
  line-height: 1.35;
  -webkit-line-clamp: 2;
}

.course-learning {
  margin-top: 12rpx;
  color: #6f7280;
  font-size: 25rpx;
  font-weight: 500;
  line-height: 1.45;
  -webkit-line-clamp: 1;
}

.course-footer {
  margin-top: auto;
  display: flex;
  align-items: center;
  color: #75766f;
  font-size: 24rpx;
  line-height: 1.3;
}

.meta-divider {
  margin: 0 10rpx;
  color: #b8b3a8;
}

.course-progress-text {
  color: #dc6845;
  font-weight: 650;
}

.preview-pill {
  margin-left: auto;
  padding: 5rpx 11rpx;
  border-radius: 10rpx;
  background: #fff4c7;
  color: #886800;
  font-size: 20rpx;
  font-weight: 650;
}

.empty-symbol {
  width: 112rpx;
  height: 112rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 34rpx;
  background: #f5d060;
  color: #2d2d2d;
  font-size: 42rpx;
  font-weight: 800;
}

.empty-title {
  margin-top: 30rpx;
  color: #36332e;
  font-size: 31rpx;
  font-weight: 700;
}

.empty-copy {
  max-width: 560rpx;
  margin-top: 16rpx;
  color: #817a6e;
  font-size: 25rpx;
  line-height: 1.7;
}
