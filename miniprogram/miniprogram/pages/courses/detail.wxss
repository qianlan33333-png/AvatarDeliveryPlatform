.detail-page {
  padding-bottom: calc(52rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(52rpx + env(safe-area-inset-bottom));
}

.detail-state {
  min-height: 360rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7c756a;
  font-size: 27rpx;
}

.detail-error {
  color: #9f3b32;
  text-align: center;
}

.detail-retry {
  margin-top: 28rpx;
}

.hero-card {
  overflow: hidden;
}

.hero-cover {
  width: 100%;
  height: 360rpx;
}

.hero-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #f5d060, #fff6cf);
  color: rgba(45, 45, 45, 0.72);
  font-size: 84rpx;
  font-weight: 800;
}

.hero-body {
  padding: 32rpx;
}

.access-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #8b8479;
  font-size: 23rpx;
}

.access-badge {
  padding: 8rpx 16rpx;
  border-radius: 99rpx;
  background: #fff4bd;
  color: #806500;
}

.access-badge.open {
  background: #e6f6ea;
  color: #16803a;
}

.detail-title,
.detail-subtitle,
.detail-description {
  display: block;
}

.contact-button {
  height: 84rpx;
  margin: 28rpx 0 0;
  border: 0;
  border-radius: 42rpx;
  background: #f5d060;
  color: #2d2d2d;
  font-size: 27rpx;
  font-weight: 750;
  line-height: 84rpx;
}

.contact-button::after {
  border: 0;
}

.detail-title {
  margin-top: 24rpx;
  color: #2d2d2d;
  font-size: 40rpx;
  font-weight: 800;
  line-height: 1.35;
}

.detail-subtitle {
  margin-top: 10rpx;
  color: #6d675e;
  font-size: 28rpx;
}

.detail-description {
  margin-top: 22rpx;
  color: #817a6e;
  font-size: 27rpx;
  line-height: 1.75;
}

.lesson-heading {
  margin: 42rpx 8rpx 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.lesson-heading-title {
  color: #36332e;
  font-size: 31rpx;
  font-weight: 750;
}

.lesson-heading-note {
  color: #999286;
  font-size: 22rpx;
}

.lesson-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.lesson-row {
  min-height: 150rpx;
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.lesson-row.locked {
  opacity: 0.72;
}

.lesson-order {
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f5d060;
  color: #2d2d2d;
  font-size: 24rpx;
  font-weight: 800;
}

.lesson-copy {
  min-width: 0;
  flex: 1;
  margin-left: 20rpx;
}

.lesson-title-row,
.lesson-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.lesson-title {
  color: #37342f;
  font-size: 29rpx;
  font-weight: 700;
}

.preview-tag {
  padding: 4rpx 10rpx;
  border-radius: 12rpx;
  background: #fff4bd;
  color: #806500;
  font-size: 20rpx;
}

.lesson-description {
  margin-top: 8rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #817b71;
  font-size: 24rpx;
  line-height: 1.5;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 1;
}

.lesson-meta {
  margin-top: 12rpx;
  color: #9c958a;
  font-size: 21rpx;
}

.lesson-action {
  margin-left: 16rpx;
  color: #9a7200;
  font-size: 24rpx;
  font-weight: 650;
}
