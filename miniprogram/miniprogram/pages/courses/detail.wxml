<view class="screen detail-page">
  <view wx:if="{{loading}}" class="detail-state surface-card">正在加载课程…</view>
  <view wx:elif="{{error}}" class="detail-state surface-card">
    <text class="detail-error">{{error}}</text>
    <button class="primary-button detail-retry" bindtap="loadCourse">重新加载</button>
  </view>
  <block wx:elif="{{course}}">
    <view class="progress-card surface-card">
      <text class="learning-position">{{course.learning_text}}</text>
      <view class="progress-summary">
        <text>共 {{course.lesson_count}} 讲</text>
        <text class="progress-percent">已学 {{course.progress_percent}}%</text>
      </view>
      <progress
        class="course-progress"
        percent="{{course.progress_percent}}"
        stroke-width="4"
        activeColor="#D97757"
        backgroundColor="#EDEAE1"
      ></progress>
    </view>

    <view class="lesson-panel surface-card">
      <view class="lesson-toolbar">
        <text class="lesson-heading-title">课节列表 · {{course.lesson_count}}</text>
        <label class="lesson-filter">
          <text>只看未学完</text>
          <switch
            checked="{{showIncompleteOnly}}"
            disabled="{{!course.lessons.length}}"
            color="#D97757"
            bindchange="toggleIncomplete"
          ></switch>
        </label>
      </view>

      <view wx:if="{{visibleLessons.length}}" class="lesson-list">
        <view
          wx:for="{{visibleLessons}}"
          wx:key="id"
          class="lesson-row {{item.locked ? 'locked' : ''}}"
          data-id="{{item.id}}"
          bindtap="openLesson"
          hover-class="lesson-row-active"
          aria-role="button"
          aria-label="第 {{item.lesson_number}} 讲 {{item.title}}"
        >
          <text class="lesson-title">第 {{item.lesson_number}} 讲｜{{item.title}}</text>
          <view class="lesson-meta">
            <text>{{item.study_text}}</text>
            <text wx:if="{{item.is_preview}}" class="preview-tag">试听</text>
            <text wx:if="{{item.locked}}" class="locked-tag">锁定</text>
          </view>
        </view>
      </view>

      <view wx:elif="{{showIncompleteOnly && course.lessons.length}}" class="lesson-empty">
        <text class="lesson-empty-title">所有课节都学完了</text>
        <button class="show-all-button" bindtap="showAllLessons">查看全部课节</button>
      </view>

      <view wx:else class="lesson-empty">
        <text class="lesson-empty-title">暂时还没有课节</text>
        <text class="lesson-empty-copy">课程发布课节后会显示在这里。</text>
      </view>
    </view>
  </block>
</view>
