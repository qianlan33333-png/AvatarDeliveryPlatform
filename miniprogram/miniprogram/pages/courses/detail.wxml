<view class="screen detail-page">
  <view wx:if="{{loading}}" class="detail-state surface-card">正在加载课程…</view>
  <view wx:elif="{{error}}" class="detail-state surface-card">
    <text class="detail-error">{{error}}</text>
    <button class="primary-button detail-retry" bindtap="loadCourse">重新加载</button>
  </view>
  <block wx:elif="{{course}}">
    <view class="hero-card surface-card">
      <image wx:if="{{course.cover_url}}" class="hero-cover" src="{{course.cover_url}}" mode="aspectFill"></image>
      <view wx:else class="hero-cover hero-fallback">课</view>
      <view class="hero-body">
        <view class="access-row">
          <text class="access-badge {{course.has_access ? 'open' : ''}}">{{course.has_access ? '已开通完整课程' : '可查看简介与试听'}}</text>
          <text>{{course.lesson_count}} 个课节</text>
        </view>
        <text class="detail-title">{{course.title}}</text>
        <text wx:if="{{course.subtitle}}" class="detail-subtitle">{{course.subtitle}}</text>
        <text class="detail-description">{{course.description}}</text>
        <button
          wx:if="{{!course.has_access}}"
          class="contact-button"
          open-type="contact"
          session-from="course:{{course.id}}"
        >联系运营开通完整课程</button>
      </view>
    </view>

    <view class="lesson-heading">
      <text class="lesson-heading-title">课节目录</text>
      <text class="lesson-heading-note">试听课节可直接播放</text>
    </view>
    <view class="lesson-list">
      <view wx:for="{{course.lessons}}" wx:key="id" class="lesson-row surface-card {{item.locked ? 'locked' : ''}}" data-id="{{item.id}}" bindtap="openLesson">
        <view class="lesson-order">{{index + 1}}</view>
        <view class="lesson-copy">
          <view class="lesson-title-row">
            <text class="lesson-title">{{item.title}}</text>
            <text wx:if="{{item.is_preview}}" class="preview-tag">试听</text>
          </view>
          <text wx:if="{{item.description}}" class="lesson-description">{{item.description}}</text>
          <view class="lesson-meta">
            <text>{{item.duration_text}}</text>
            <text wx:if="{{item.completed}}">已学完</text>
            <text wx:elif="{{item.position_seconds}}">已学 {{item.position_seconds}} 秒</text>
          </view>
        </view>
        <text class="lesson-action">{{item.locked ? '锁定' : '播放'}} ›</text>
      </view>
    </view>
  </block>
</view>
