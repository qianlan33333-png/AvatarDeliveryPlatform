page {
  height: 100%;
  overflow: hidden;
  background: #faf9f7;
}

.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #faf9f7;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-content {
  padding: 32rpx 28rpx 44rpx;
}

.welcome-card {
  display: flex;
  align-items: flex-start;
  padding: 36rpx 32rpx;
}

.assistant-mark {
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  background: #f5d060;
  color: #2d2d2d;
  font-size: 26rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.welcome-copy {
  min-width: 0;
  margin-left: 24rpx;
}

.welcome-copy .section-title {
  font-size: 38rpx;
}

.prompt-section {
  margin-top: 44rpx;
}

.prompt-label {
  display: block;
  margin: 0 8rpx 20rpx;
  color: #777166;
  font-size: 26rpx;
  font-weight: 600;
}

.prompt-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.prompt-chip {
  padding: 18rpx 24rpx;
  border: 2rpx solid #ebe5d8;
  border-radius: 32rpx;
  background: #ffffff;
  color: #4c4942;
  font-size: 26rpx;
  line-height: 1.4;
}

.status-note {
  margin-top: 36rpx;
  display: flex;
  align-items: center;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: #f6f1e5;
  color: #8a8377;
  font-size: 24rpx;
  line-height: 1.5;
}

.status-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  margin-right: 14rpx;
  border-radius: 50%;
  background: #e0a93c;
}

.composer {
  display: flex;
  align-items: flex-end;
  padding: 20rpx 24rpx;
  border-top: 2rpx solid #eeeae2;
  background: #ffffff;
}

.composer-input {
  min-height: 84rpx;
  max-height: 240rpx;
  flex: 1;
  padding: 21rpx 28rpx;
  border: 2rpx solid #e7e2d8;
  border-radius: 30rpx;
  background: #faf9f7;
  color: #2d2d2d;
  font-size: 29rpx;
  line-height: 1.45;
}

.composer-placeholder {
  color: #aaa398;
}

.send-button {
  width: 104rpx;
  height: 84rpx;
  min-width: 104rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: #ece8df;
  color: #9a9489;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}

.send-button.is-ready {
  background: #f5d060;
  color: #2d2d2d;
}
