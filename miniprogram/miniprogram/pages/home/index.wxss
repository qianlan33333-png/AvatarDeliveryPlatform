.home-page { padding: 36rpx 28rpx calc(136rpx + env(safe-area-inset-bottom)); background: #faf9f5; }
.home-guidance { display: block; margin: 2rpx 6rpx 26rpx; color: #8f8b83; font-size: 25rpx; }
.status-banner { margin-bottom: 22rpx; padding: 18rpx 22rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border: 2rpx solid #eccfc5; border-radius: 16rpx; background: #f8e9e4; color: #bc4c2e; font-size: 24rpx; }
.status-retry { flex-shrink: 0; color: #a24a2c; font-weight: 700; }
.entry-list { display: flex; flex-direction: column; gap: 24rpx; }
.entry-card { min-height: 330rpx; padding: 30rpx; display: flex; flex-direction: column; border: 2rpx solid #e5e2da; border-radius: 24rpx; background: #fff; box-shadow: 0 2rpx 4rpx rgba(60,50,40,.04); }
.entry-card.locked { background: #f5f3ed; box-shadow: none; }
.entry-card:active { background: #fdf9f7; }
.entry-card.locked:active { background: #efede6; }
.entry-head { display: flex; align-items: flex-start; justify-content: space-between; }
.entry-mark { width: 88rpx; height: 88rpx; display: flex; align-items: center; justify-content: center; border-radius: 28rpx; background: #f7ede8; color: #c15f3c; font-family: "Songti SC", serif; font-size: 31rpx; font-weight: 700; }
.entry-card.locked .entry-mark { background: #efede6; color: #8f8b83; }
.entry-state { padding: 7rpx 14rpx; border-radius: 12rpx; background: #efede6; color: #6b6862; font-size: 21rpx; font-weight: 650; }
.entry-state.active { background: #e9efe8; color: #4a6b52; }
.entry-title, .entry-description { display: block; }
.entry-title { margin-top: 24rpx; color: #1f1e1d; font-family: "Songti SC", serif; font-size: 42rpx; font-weight: 700; line-height: 1.35; }
.entry-description { margin-top: 10rpx; color: #6b6862; font-size: 27rpx; line-height: 1.65; }
.entry-card.locked .entry-title, .entry-card.locked .entry-description { color: #8f8b83; }
.entry-footer { margin-top: auto; padding-top: 24rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; border-top: 2rpx solid #edeae1; }
.entry-period { min-width: 0; flex: 1; color: #8f8b83; font-size: 22rpx; }
.entry-action { flex-shrink: 0; color: #c15f3c; font-size: 24rpx; font-weight: 700; }
.entry-card.locked .entry-action { color: #8f8b83; }
