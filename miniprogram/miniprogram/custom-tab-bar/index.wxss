.tabbar { position: fixed; z-index: 1000; right: 0; bottom: 0; left: 0; min-height: 104rpx; padding: 0 52rpx env(safe-area-inset-bottom); display: flex; align-items: center; justify-content: space-between; border-top: 2rpx solid #edeae1; background: #fff; }
.tab-item { min-width: 150rpx; height: 104rpx; display: flex; align-items: center; justify-content: center; color: #8f8b83; font-size: 34rpx; font-weight: 400; }
.tab-item.selected { color: #c15f3c; font-weight: 700; }
