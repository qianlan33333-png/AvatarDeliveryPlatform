:host {
  height: 100%;
  display: block;
}

.chat-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #faf9f7;
}

.chat-scroll {
  min-height: 0;
  flex: 1;
}

.message-list {
  padding: 30rpx 24rpx 44rpx;
}

.message-row {
  margin-bottom: 28rpx;
  display: flex;
  align-items: flex-start;
}

.message-row.user {
  justify-content: flex-end;
}

.assistant-mark {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: #f5d060;
  color: #2d2d2d;
  font-size: 22rpx;
  font-weight: 800;
}

.message-content {
  min-width: 0;
  max-width: calc(100% - 86rpx);
}

.message-row.assistant .message-content {
  margin-left: 18rpx;
}

.message-bubble {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 29rpx;
  line-height: 1.65;
  word-break: break-word;
}

.message-bubble.assistant {
  border: 2rpx solid #ebe6dc;
  border-top-left-radius: 8rpx;
  background: #ffffff;
  color: #38352f;
  box-shadow: 0 8rpx 28rpx rgba(52, 45, 29, 0.05);
}

.message-bubble.user {
  border-top-right-radius: 8rpx;
  background: #f5d060;
  color: #2d2d2d;
}

.typing-indicator {
  height: 34rpx;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.typing-indicator text {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #b5ad9f;
  animation: pulse 1.1s infinite ease-in-out;
}

.typing-indicator text:nth-child(2) { animation-delay: 0.15s; }
.typing-indicator text:nth-child(3) { animation-delay: 0.3s; }

@keyframes pulse {
  0%, 70%, 100% { opacity: 0.35; transform: translateY(0); }
  35% { opacity: 1; transform: translateY(-5rpx); }
}

.recommendation-list {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.answer-images {
  margin-top: 14rpx;
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.answer-image-card {
  overflow: hidden;
  border: 2rpx solid #ebe6dc;
  border-radius: 20rpx;
  background: #ffffff;
}

.answer-image {
  width: 100%;
  display: block;
}

.answer-image-alt {
  display: block;
  padding: 12rpx 14rpx 14rpx;
  color: #777166;
  font-size: 21rpx;
  line-height: 1.45;
}

.recommendation-card {
  overflow: hidden;
  display: flex;
  border: 2rpx solid #eadfac;
  border-radius: 22rpx;
  background: #fffdf7;
}

.recommendation-cover {
  width: 148rpx;
  min-height: 150rpx;
  flex-shrink: 0;
}

.recommendation-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #f5d060, #fff4bd);
  color: #725a00;
  font-size: 42rpx;
  font-weight: 800;
}

.recommendation-copy {
  min-width: 0;
  flex: 1;
  padding: 20rpx;
}

.recommendation-head {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.recommendation-title {
  min-width: 0;
  flex: 1;
  color: #35322c;
  font-size: 27rpx;
  font-weight: 750;
}

.recommendation-state {
  flex-shrink: 0;
  color: #9a7200;
  font-size: 20rpx;
}

.recommendation-description {
  margin-top: 9rpx;
  display: -webkit-box;
  overflow: hidden;
  color: #827b70;
  font-size: 22rpx;
  line-height: 1.45;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.recommendation-action {
  margin-top: 12rpx;
  display: block;
  color: #9a7200;
  font-size: 22rpx;
  font-weight: 650;
}

.prompt-section {
  margin: 44rpx 8rpx 0;
}

.prompt-label {
  display: block;
  margin-bottom: 18rpx;
  color: #777166;
  font-size: 25rpx;
  font-weight: 600;
}

.prompt-list {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.prompt-chip {
  padding: 17rpx 22rpx;
  border: 2rpx solid #ebe5d8;
  border-radius: 30rpx;
  background: #ffffff;
  color: #4c4942;
  font-size: 25rpx;
  line-height: 1.4;
}

.bottom-anchor {
  height: 12rpx;
}

.composer {
  display: flex;
  align-items: flex-end;
  padding: 20rpx 24rpx;
  border-top: 2rpx solid #eeeae2;
  background: #ffffff;
}

.safe-area-bottom {
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
}

.composer-input {
  min-height: 84rpx;
  max-height: 240rpx;
  flex: 1;
  padding: 21rpx 28rpx;
  border: 2rpx solid #e7e2d8;
  border-radius: 30rpx;
  background: #faf9f7;
  color: #2d2d2d;
  font-size: 29rpx;
  line-height: 1.45;
}

.composer-placeholder {
  color: #aaa398;
}

.send-button {
  width: 104rpx;
  height: 84rpx;
  min-width: 104rpx;
  margin-left: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 30rpx;
  background: #ece8df;
  color: #9a9489;
  font-size: 27rpx;
  font-weight: 600;
  line-height: 1;
}

.send-button.is-ready {
  background: #f5d060;
  color: #2d2d2d;
}
